{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "importHelpers": true,
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sbrb/shared-types": ["libs/shared/types/src/index.ts"],
      "@sbrb/shared-constants": ["libs/shared/constants/src/index.ts"],
      "@sbrb/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@sbrb/shared-utils/*": ["libs/shared/utils/src/*"],
      "@sbrb/ui": ["libs/ui/src/index.ts"],
      "@sbrb/i18n": ["libs/i18n/src/index.ts"],
      "@sbrb/shared-apollo-client": ["libs/shared/apollo-client/src/index.ts"],
      "@sbrb/api-entities/datasheet/*": ["apps/api/src/modules/datasheet/entities/*"],
      "@sbrb/api-entities/auth/*": ["apps/api/src/modules/auth/entities/*"],
      "@sbrb/api-entities/business/*": ["apps/api/src/modules/business/entities/*"],
      "@sbrb/api-entities/widget/*": ["apps/api/src/modules/widget/entities/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
