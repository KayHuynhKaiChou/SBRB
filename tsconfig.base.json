{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sbrb/shared-types": ["libs/shared/types/src/index.ts"],
      "@sbrb/shared-constants": ["libs/shared/constants/src/index.ts"],
      "@sbrb/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@sbrb/ui": ["libs/ui/src/index.ts"],
      "@sbrb/i18n": ["libs/i18n/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
