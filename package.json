{
  "name": "sbrb",
  "version": "0.1.0",
  "description": "Small Business Report Board — Free-form Canvas Dashboard",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "nx serve web",
    "dev:api": "nodemon --watch apps/api/src --watch libs --ext ts --exec \"ts-node --project apps/api/tsconfig.app.json -r tsconfig-paths/register apps/api/src/main.ts\"",
    "dev:desktop": "nx serve desktop",
    "build:web": "nx build web",
    "build:api": "nx build api",
    "build:desktop": "nx build desktop",
    "package:desktop": "nx package desktop",
    "build:all": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "type-check": "nx run-many --target=type-check --all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/shared/*",
    "libs/i18n"
  ],
  "devDependencies": {
    "@nx/eslint": "^22.0.0",
    "@nx/eslint-plugin": "^22.0.0",
    "@nx/jest": "^22.0.0",
    "@nx/js": "^22.0.0",
    "@nx/nest": "^22.0.0",
    "@nx/node": "^22.0.0",
    "@nx/react": "^22.0.0",
    "@nx/vite": "^22.0.0",
    "@nx/webpack": "^22.0.0",
    "@swc-node/register": "^1.9.0",
    "@swc/core": "^1.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^29.0.1",
    "nodemon": "^3.1.14",
    "nx": "^22.0.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@supabase/supabase-js": "^2.104.1",
    "@uidotdev/usehooks": "^2.4.1",
    "@xyflow/react": "^12.10.2",
    "antd-img-crop": "^4.30.0",
    "graphql-subscriptions": "^3.0.0",
    "ioredis": "^5.10.1",
    "lodash": "^4.18.1",
    "minio": "^8.0.7"
  }
}
