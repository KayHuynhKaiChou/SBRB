{
  "name": "sbrb",
  "version": "0.1.0",
  "description": "Small Business Report Board — Free-form Canvas Dashboard",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "build:web": "nx build web",
    "build:api": "nx build api",
    "build:worker": "nx build worker",
    "build:all": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "type-check": "nx run-many --target=type-check --all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/shared/*",
    "libs/i18n"
  ],
  "devDependencies": {
    "@nx/eslint": "^22.0.0",
    "@nx/eslint-plugin": "^22.0.0",
    "@nx/jest": "^22.0.0",
    "@nx/js": "^22.0.0",
    "@nx/nest": "^22.0.0",
    "@nx/node": "^22.0.0",
    "@nx/react": "^22.0.0",
    "@nx/vite": "^22.0.0",
    "@nx/webpack": "^22.0.0",
    "@swc-node/register": "^1.9.0",
    "@swc/core": "^1.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "nx": "^22.0.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
